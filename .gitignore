# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated by scripts/generate-icons.ts (npm run icons)
/src/generated/
/public/downloads/

# generated by scripts/build-package.ts (npm run package)
/packages/energy-icons/src/icons/
/packages/energy-icons/src/index.ts
/packages/energy-icons/src/registry.ts
/packages/energy-icons/dist/
/packages/energy-icons/svg/
/packages/energy-icons/font/

# copied from the root LICENSE by scripts/build-package.ts
/packages/energy-icons/LICENSE

# generated by scripts/generate-icons.ts for the Figma plugin
/public/figma/

# built by scripts/build-figma-plugin.ts (npm run figma)
/packages/figma-plugin/dist/
