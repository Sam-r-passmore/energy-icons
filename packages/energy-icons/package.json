{
  "name": "energy-icons",
  "version": "1.5.0",
  "description": "Open-source icons for the energy transition. React components, SVG files and an icon font, MIT licensed.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist", "svg", "font", "codepoints.json", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icon": {
      "types": "./dist/dynamic.d.ts",
      "import": "./dist/dynamic.js",
      "default": "./dist/dynamic.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js",
      "default": "./dist/icons/*.js"
    },
    "./svg/*": "./svg/*",
    "./font/*": "./font/*",
    "./codepoints.json": "./codepoints.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Sam Passmore (ItsSam)",
  "homepage": "https://energyicons.com",
  "bugs": {
    "url": "https://github.com/Sam-r-passmore/energy-icons/issues"
  },
  "funding": "https://ko-fi.com/energyicons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sam-r-passmore/energy-icons.git",
    "directory": "packages/energy-icons"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "keywords": ["icons", "svg", "react", "energy", "renewable", "climate", "solar", "wind", "ev-charging", "grid"]
}
